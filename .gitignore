__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.installed.cfg
*.egg
build/
dist/

# Audio files & custom tracks (NEVER commit to Git)
assets/audio/custom_tracks/
assets/audio/*.wav
assets/audio/*.mp3
assets/audio/*.m4a

# Binaries (>100MB)
bin/*.exe
!bin/.gitkeep

# Temporary, OpenFilm, and output directories
temp/*
!temp/.gitkeep
temp/openfilm_projects/
temp/style_ref/
.film/
output/*
!output/.gitkeep

# Sensitive Credentials & Auth
.env
token.json
client_secrets.json
youtube_auth_profile/
*.session

# Cache & IDE
.cache/
.pytest_cache/
.vscode/
.idea/
*.png
