# ===================================================================
# CLIPWA CONFIGURATION ENVIRONMENT
# ===================================================================

# 1. Google Gemini API (Free tier from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Alternative LLM Providers (Optional fallbacks)
GROQ_API_KEY=your_groq_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# 3. Whisper Speech-to-Text Settings (Runs 100% locally)
WHISPER_MODEL=tiny           # tiny, base, small, medium, large-v3
WHISPER_DEVICE=cpu           # cpu or cuda
WHISPER_COMPUTE_TYPE=int8    # int8 or float16

# 4. YouTube Shorts Direct Upload (OAuth 2.0)
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_TOKEN_FILE=token.json
